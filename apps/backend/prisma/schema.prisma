// apps/backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum ShopStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  INACTIVE
}

enum Role {
  SUPER_ADMIN
  OPS_ADMIN
  FINANCE_ADMIN
  SHOP_MANAGER
  SHOP_STAFF
}

enum GameStatus {
  ACTIVE
  INACTIVE
}

enum PrizeType {
  CASH
  FREE_TICKET
  NONE
}

enum DrawStatus {
  SCHEDULED
  OPEN
  SALES_CLOSED
  DRAW_IN_PROGRESS
  RESULT_GENERATED
  RESULT_PUBLISHED
  REDEMPTION_OPEN
  CLOSED
}

enum VoucherStatus {
  CREATED
  SOLD
  DRAW_PENDING
  DRAW_COMPLETED
  WINNER
  NON_WINNER
  REDEEMED
  EXPIRED
  VOID
  CANCELLED
}

enum WalletTxType {
  SALE
  PAYOUT
  TOPUP
  ADJUSTMENT
  REFUND
}

enum WinnerStatus {
  PENDING
  ELIGIBLE
  REDEEMED
  EXPIRED
}

enum SaleStatus {
  PENDING
  COMPLETED
  VOID
  REFUNDED
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model Shop {
  id          String         @id @default(uuid())
  name        String
  code        String         @unique
  status      ShopStatus     @default(ACTIVE)
  creditLimit Decimal        @default(0) @db.Decimal(12, 3)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  users       User[]
  wallet      Wallet?
  sales       Sale[]
  vouchers    Voucher[]
  redemptions Redemption[]

  @@index([code])
  @@index([status])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  shopId       String?
  shop         Shop?    @relation(fields: [shopId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs    AuditLog[]

  @@index([shopId])
  @@index([role])
}

model Game {
  id         String     @id @default(uuid())
  code       String     @unique
  name       String
  digitCount Int
  minNumber  Int
  maxNumber  Int
  entryPrice Decimal    @db.Decimal(12, 3)
  status     GameStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  rules    GameRule[]
  draws    Draw[]
  vouchers Voucher[]

  @@index([code])
  @@index([status])
}

model GameRule {
  id          String    @id @default(uuid())
  gameId      String
  code        String
  label       String
  matchConfig Json
  prizeType   PrizeType
  prizeAmount Decimal?  @db.Decimal(12, 3)
  priority    Int
  createdAt   DateTime  @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, code])
  @@index([gameId])
}

model Draw {
  id             String     @id @default(uuid())
  gameId         String
  drawNumber     String     @unique
  scheduledAt    DateTime
  salesCloseAt   DateTime
  status         DrawStatus @default(SCHEDULED)
  winningNumbers Json?
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  game      Game        @relation(fields: [gameId], references: [id])
  result    DrawResult?
  vouchers  Voucher[]
  winners   Winner[]

  @@index([gameId, status])
  @@index([scheduledAt])
}

model DrawResult {
  id             String   @id @default(uuid())
  drawId         String   @unique
  winningNumbers Json
  publishedAt    DateTime?
  createdAt      DateTime @default(now())

  draw Draw @relation(fields: [drawId], references: [id], onDelete: Cascade)
}

model Sale {
  id             String     @id @default(uuid())
  shopId         String
  total          Decimal    @db.Decimal(12, 3)
  status         SaleStatus @default(COMPLETED)
  idempotencyKey String?    @unique
  createdAt      DateTime   @default(now())

  shop     Shop      @relation(fields: [shopId], references: [id])
  vouchers Voucher[]

  @@index([shopId, createdAt])
}

model Voucher {
  id              String        @id @default(uuid())
  code            String        @unique
  qrToken         String        @unique
  gameId          String
  drawId          String
  shopId          String
  saleId          String
  selectedNumbers Json
  quantity        Int
  unitPrice       Decimal       @db.Decimal(12, 3)
  totalAmount     Decimal       @db.Decimal(12, 3)
  status          VoucherStatus @default(CREATED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  game       Game        @relation(fields: [gameId], references: [id])
  draw       Draw        @relation(fields: [drawId], references: [id])
  shop       Shop        @relation(fields: [shopId], references: [id])
  sale       Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  winner     Winner?

  @@index([shopId, createdAt])
  @@index([drawId, status])
  @@index([code])
}

model Wallet {
  id        String   @id @default(uuid())
  shopId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(12, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop         Shop                @relation(fields: [shopId], references: [id])
  transactions WalletTransaction[]
}

model WalletTransaction {
  id             String       @id @default(uuid())
  walletId       String
  type           WalletTxType
  amount         Decimal      @db.Decimal(12, 3)
  balanceBefore  Decimal      @db.Decimal(12, 3)
  balanceAfter   Decimal      @db.Decimal(12, 3)
  reference      String?
  idempotencyKey String?      @unique
  createdBy      String?
  createdAt      DateTime     @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
}

model Winner {
  id          String       @id @default(uuid())
  voucherId   String       @unique
  drawId      String
  matchType   String
  prizeAmount Decimal      @db.Decimal(12, 3)
  status      WinnerStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  voucher    Voucher     @relation(fields: [voucherId], references: [id])
  draw       Draw        @relation(fields: [drawId], references: [id])
  redemption Redemption?

  @@index([drawId, status])
}

model Redemption {
  id            String   @id @default(uuid())
  winnerId      String   @unique
  shopId        String
  amount        Decimal  @db.Decimal(12, 3)
  transactionId String?
  redeemedAt    DateTime @default(now())

  winner Winner @relation(fields: [winnerId], references: [id])
  shop   Shop   @relation(fields: [shopId], references: [id])

  @@index([shopId, redeemedAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}